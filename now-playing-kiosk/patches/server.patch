+import type { Request, Response } from 'express';
+import np from '../lib/NowPlayingContext';
+import { isKiosk } from './Encoder';
+
+const validPath = (path: string) => /^(USB|NAS|INTERNAL)\//.test(path) &&
+  !/[\x00-\x1f\x7f]/.test(path) && path.split('/').every(part => part && part !== '.' && part !== '..');
+
+type SourceFormat = { sampleRate?: number; bitDepth?: number; channels?: number; dsdRate?: number };
+
+export function parseFormat(format: string): SourceFormat {
+  const dsd = /^dsd(\d+):(\d+)$/i.exec(format);
+  if (dsd) return { dsdRate: Number(dsd[1]) * 44100, bitDepth: 1, channels: Number(dsd[2]) };
+  const dsdBytes = /^(\d+):dsd:(\d+)$/i.exec(format);
+  if (dsdBytes) return { dsdRate: Number(dsdBytes[1]) * 8, bitDepth: 1, channels: Number(dsdBytes[2]) };
+  const pcm = /^(\d+):(\d+|f):(\d+)$/.exec(format);
+  if (!pcm) return {};
+  return { sampleRate: Number(pcm[1]), bitDepth: Number(pcm[2]) || undefined, channels: Number(pcm[3]) };
+}
+
+const libraryPath = (uri: string) => uri.replace(/^\/?(?:mnt|music-library)\//, '');
+
+async function mpdLines(verb: 'lsinfo' | 'listplaylistinfo', path: string) {
+  const mpd = np.getMusicServicePlugin('mpd');
+  if (!mpd?.clientMpd || !validPath(path)) return [];
+  const command = `${verb} "${path.replace(/["\\]/g, '\\$&')}"`;
+  const data = await new Promise<string>((resolve, reject) => {
+    const timeout = setTimeout(() => reject(new Error(`MPD ${verb} timed out`)), 3000);
+    mpd.clientMpd.sendCommand(command, (error: Error | null, message: string) => {
+      clearTimeout(timeout);
+      if (error) reject(error);
+      else resolve(message);
+    });
+  });
+  return data.split('\n');
+}
+
+async function indexFormat(path: string): Promise<SourceFormat> {
+  const lines = await mpdLines('lsinfo', path);
+  let selected = false;
+  for (const line of lines) {
+    if (/^(?:file|directory|playlist): /.test(line)) selected = line === `file: ${path}`;
+    if (selected && line.startsWith('Format: ')) return parseFormat(line.slice(8));
+  }
+  return {};
+}
+
+export async function localQuality(uri: string) {
+  const artwork = np.getArtworkOne();
+  if (!artwork?.localMusic) return {};
+  const legacy = /^cue:\/\/(.+\.cue)@(\d+)$/i.exec(uri);
+  const cue = legacy || /^(.*\.cue)\/track(\d+)$/i.exec(uri);
+  let path = libraryPath(uri);
+  if (cue) {
+    const entries = await mpdLines('listplaylistinfo', libraryPath(cue[1])).catch(() => []);
+    const position = Number(cue[2]) - (legacy ? 0 : 1);
+    path = entries.filter(line => line.startsWith('file: '))[position]?.slice(6) || '';
+  }
+  if (!path || !validPath(path)) return {};
+  const [file, format] = await Promise.all([
+    cue ? null : artwork.getLocalFileInfo({ uri }),
+    indexFormat(path).catch((): SourceFormat => ({}))
+  ]);
+  const source = /\.(?:dsf|dff)$/i.test(path) && !format.dsdRate ? {} as SourceFormat : format;
+  return {
+    ...source,
+    bitDepth: /\.mp3$/i.test(path) ? undefined : source.bitDepth,
+    bitrate: file?.bitrate > 0 ? Math.round(file.bitrate / 1000) : undefined
+  };
+}
+
+export async function trackQuality(req: Request, res: Response) {
+  if (!isKiosk(req)) return res.sendStatus(404);
+  res.set('Cache-Control', 'no-store');
+  try {
+    const state = np.getPlayerState();
+    const uri = req.query.uri;
+    if (typeof uri !== 'string' || uri.length > 4096 || state?.uri !== uri || state.status === 'stop') {
+      return res.json({});
+    }
+    if (state.service === 'mpd') {
+      const quality = await localQuality(uri);
+      const current = np.getPlayerState();
+      return res.json(current?.uri === uri && current.status !== 'stop' ? quality : {});
+    }
+    if (state.service === 'yandex_music' || state.service === 'qobuz_custom') {
+      const playback = np.getMusicServicePlugin(state.service)?.playback;
+      const quality = playback?.lastQuality;
+      if (quality?.generation && quality.uri === uri && playback.current()) return res.json(quality);
+    }
+    return res.json({});
+  }
+  catch (error) {
+    np.getLogger().warn('[now-playing] Could not read source format');
+    return res.status(503).json({});
+  }
+}
