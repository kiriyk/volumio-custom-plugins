+import { constants } from 'fs';
+import { open, stat, type FileHandle } from 'fs/promises';
+import type { Request, Response } from 'express';
+
+export const isKiosk = (req: Request) =>
+  ['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(req.socket.remoteAddress || '') &&
+  req.headers.host === 'localhost:4004' &&
+  (!req.headers.origin || req.headers.origin === 'http://localhost:4004');
+
+export class Gestures {
+  private pressed = false;
+  private held = false;
+  private second = false;
+  private timer?: NodeJS.Timeout;
+
+  constructor(private emit: (event: string) => void) {}
+
+  input(pressed: boolean) {
+    if (this.pressed === pressed) return;
+    this.pressed = pressed;
+    if (pressed) {
+      this.second = !!this.timer;
+      clearTimeout(this.timer);
+      this.held = false;
+      this.timer = setTimeout(() => {
+        this.timer = undefined;
+        this.held = true;
+        this.emit('long');
+      }, 650);
+      return;
+    }
+    clearTimeout(this.timer);
+    this.timer = undefined;
+    if (this.held) return;
+    if (this.second) {
+      this.emit('double');
+      return;
+    }
+    this.timer = setTimeout(() => {
+      this.timer = undefined;
+      this.emit('short');
+    }, 300);
+  }
+
+  reset() {
+    clearTimeout(this.timer);
+    this.timer = undefined;
+    this.pressed = this.held = this.second = false;
+  }
+}
+
+class InputDevice {
+  private file?: FileHandle;
+  private timer?: NodeJS.Timeout;
+  private generation = 0;
+  private buffer = Buffer.alloc(4096);
+  private remaining = Buffer.alloc(0);
+  private identity = '';
+  private nextCheck = 0;
+  private dropped = false;
+
+  constructor(private path: string, private event: (type: number, code: number, value: number) => void,
+    private reset: () => void = () => {}) {}
+
+  start() {
+    const generation = ++this.generation;
+    const poll = async () => {
+      try {
+        if (!this.file || Date.now() >= this.nextCheck) {
+          const target = await stat(this.path);
+          if (generation !== this.generation) return;
+          const identity = `${target.dev}:${target.ino}:${target.rdev}`;
+          if (identity !== this.identity) this.disconnect();
+          this.nextCheck = Date.now() + 1000;
+          if (!this.file) {
+            const file = await open(this.path, constants.O_RDONLY | constants.O_NONBLOCK);
+            if (generation !== this.generation) {
+              await file.close();
+              return;
+            }
+            this.file = file;
+            this.identity = identity;
+          }
+        }
+        const { bytesRead } = await this.file.read(this.buffer, 0, this.buffer.length, null);
+        if (generation !== this.generation) return;
+        if (bytesRead === 0) this.disconnect();
+        else this.parse(this.buffer.subarray(0, bytesRead));
+      }
+      catch (error) {
+        if (generation !== this.generation) return;
+        if ((error as NodeJS.ErrnoException).code !== 'EAGAIN') this.disconnect();
+      }
+      if (generation === this.generation) this.timer = setTimeout(poll, this.file ? 12 : 1000);
+    };
+    void poll();
+  }
+
+  private parse(data: Buffer) {
+    const recordSize = process.arch === 'arm' ? 16 : 24;
+    const buffer = Buffer.concat([this.remaining, data]);
+    let offset = 0;
+    for (; offset + recordSize <= buffer.length; offset += recordSize) {
+      const payload = offset + recordSize - 8;
+      const type = buffer.readUInt16LE(payload);
+      const code = buffer.readUInt16LE(payload + 2);
+      if (type === 0) {
+        if (code === 3) {
+          this.dropped = true;
+          this.reset();
+        }
+        if (code === 0) this.dropped = false;
+      }
+      else if (!this.dropped) this.event(type, code, buffer.readInt32LE(payload + 4));
+    }
+    this.remaining = buffer.subarray(offset);
+  }
+
+  private disconnect() {
+    void this.file?.close().catch(() => {});
+    this.file = undefined;
+    this.identity = '';
+    this.remaining = Buffer.alloc(0);
+    this.dropped = false;
+    this.reset();
+  }
+
+  ready() { return !!this.file; }
+
+  stop() {
+    this.generation++;
+    clearTimeout(this.timer);
+    this.disconnect();
+  }
+}
+
+class Encoder {
+  private clients = new Set<Response>();
+  private heartbeat?: NodeJS.Timeout;
+  private gestures = new Gestures(event => this.publish(event));
+  private dial = new InputDevice('/dev/input/by-path/platform-rotary@17-event', (type, code, value) => {
+    if (type === 2 && code === 0 && value) this.publish('rotate', value);
+  }, () => this.gestures.reset());
+  private button = new InputDevice('/dev/input/by-path/platform-button@19-event', (type, _code, value) => {
+    if (this.clients.size && type === 1 && (value === 0 || value === 1)) this.gestures.input(value === 1);
+  }, () => this.gestures.reset());
+
+  start() {
+    this.dial.start();
+    this.button.start();
+    this.heartbeat = setInterval(() => this.send(': heartbeat\n\n'), 15000);
+  }
+
+  stop() {
+    this.dial.stop();
+    this.button.stop();
+    clearInterval(this.heartbeat);
+    for (const client of this.clients) client.end();
+    this.clients.clear();
+  }
+
+  subscribe(req: Request, res: Response) {
+    if (!isKiosk(req)) return res.sendStatus(404);
+    res.set({
+      'Content-Type': 'text/event-stream',
+      'Cache-Control': 'no-store',
+      'X-Accel-Buffering': 'no'
+    });
+    res.flushHeaders();
+    res.write(`event: ready\ndata: ${JSON.stringify({ dial: this.dial.ready(), button: this.button.ready() })}\n\n`);
+    this.clients.add(res);
+    res.on('close', () => {
+      this.clients.delete(res);
+      if (!this.clients.size) this.gestures.reset();
+    });
+  }
+
+  private send(message: string) {
+    for (const client of this.clients) {
+      if (!client.write(message)) {
+        this.clients.delete(client);
+        client.end();
+      }
+    }
+  }
+
+  private publish(event: string, value?: number) {
+    this.send(`data: ${JSON.stringify({ event, value })}\n\n`);
+  }
+}
+
+const encoder = new Encoder();
+export default encoder;
