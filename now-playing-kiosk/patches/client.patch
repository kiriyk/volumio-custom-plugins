diff --git a/src/kiosk/Controls.tsx b/src/kiosk/Controls.tsx
new file mode 100644
index 0000000..bbba3bb
--- /dev/null
+++ b/src/kiosk/Controls.tsx
@@ -0,0 +1,139 @@
+import React, { useEffect, useLayoutEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { usePlayerState } from '../contexts/PlayerProvider';
+import { ScreenProps, useScreens } from '../contexts/ScreenContextProvider';
+import { useSocket } from '../contexts/SocketProvider';
+import { ACTION_PANEL, METADATA_MODAL } from '../modals/CommonModals';
+import { useModals } from '../contexts/ModalStateProvider';
+import { isKiosk, useKioskData } from './Data';
+import './Kiosk.scss';
+
+const ENCODER_EVENT = 'now-playing-encoder';
+type Gesture = { event: 'rotate' | 'short' | 'long' | 'double'; value?: number };
+
+export function useEncoderGesture(active: boolean, onGesture: (gesture: Gesture) => void) {
+  const handler = useRef(onGesture);
+  useLayoutEffect(() => {
+    handler.current = onGesture;
+  });
+  useEffect(() => {
+    if (!isKiosk || !active) return;
+    const receive = (event: Event) => handler.current((event as CustomEvent<Gesture>).detail);
+    window.addEventListener(ENCODER_EVENT, receive);
+    return () => window.removeEventListener(ENCODER_EVENT, receive);
+  }, [ active ]);
+}
+
+export const moveSelection = (index: number, delta: number, count: number) =>
+  Math.max(0, Math.min(index + delta, count - 1));
+
+export function reveal(row: HTMLElement | undefined) {
+  row?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+}
+
+export function KioskController() {
+  const { socket } = useSocket();
+  const { activeScreenId, switchScreen } = useScreens();
+  const { closeModal } = useModals();
+  const { disableVolumeControl } = usePlayerState();
+  const receive = useRef<(gesture: Gesture) => void>();
+  const [ returnToPlayer, setReturnToPlayer ] = useState(0);
+
+  useLayoutEffect(() => {
+    receive.current = (gesture) => {
+      if (gesture.event === 'double') {
+        closeModal(ACTION_PANEL);
+        closeModal(METADATA_MODAL);
+        setReturnToPlayer((value) => value + 1);
+      }
+      else if (activeScreenId === 'NowPlaying') {
+        if (gesture.event === 'long') switchScreen({ screenId: 'KioskMenu' });
+        if (gesture.event === 'short' && socket?.connected) socket.emit('toggle');
+        if (gesture.event === 'rotate' && socket?.connected && !disableVolumeControl) {
+          const steps = gesture.value || 0;
+          for (let i = 0; i < Math.min(Math.abs(steps), 20); i++) socket.emit('volume', steps > 0 ? '+' : '-');
+        }
+      }
+      else if (activeScreenId) {
+        window.dispatchEvent(new CustomEvent(ENCODER_EVENT, { detail: gesture }));
+      }
+    };
+  });
+
+  useEffect(() => {
+    if (!isKiosk) return;
+    const input = new EventSource('/kiosk/encoder');
+    input.onmessage = (message) => receive.current?.(JSON.parse(message.data));
+    return () => input.close();
+  }, []);
+
+  useEffect(() => {
+    if (!returnToPlayer || !activeScreenId) return;
+    if (activeScreenId !== 'NowPlaying') {
+      switchScreen({ screenId: 'NowPlaying', screenProps: { view: 'basic' } });
+    }
+    else {
+      window.dispatchEvent(new CustomEvent(ENCODER_EVENT, { detail: { event: 'double' } }));
+      setReturnToPlayer(0);
+    }
+  }, [ returnToPlayer, activeScreenId, switchScreen ]);
+  return null;
+}
+
+type MenuProps = ScreenProps & { className?: string; style?: React.CSSProperties };
+
+export function KioskMenu({ className, style }: MenuProps) {
+  const { activeScreenId, switchScreen } = useScreens();
+  const { lyrics } = useKioskData();
+  const { i18n } = useTranslation();
+  const russian = i18n.language?.startsWith('ru');
+  const [ selected, select ] = useState(0);
+  const [ reading, read ] = useState(false);
+  const lyricsNode = useRef<HTMLDivElement>(null);
+  const active = activeScreenId === 'KioskMenu';
+  const showLyrics = reading && !!lyrics;
+  const options = [
+    { name: russian ? 'Очередь' : 'Queue', activate: () => switchScreen({ screenId: 'Queue' }) },
+    { name: russian ? 'Библиотека' : 'Library', activate: () => switchScreen({
+      screenId: 'Browse', screenProps: {
+        location: { type: 'browse', uri: '', service: null }, fromKioskMenu: true
+      }
+    }) }
+  ];
+  if (lyrics) options.push({ name: russian ? 'Текст песни' : 'Lyrics', activate: () => read(true) });
+  const selection = moveSelection(selected, 0, options.length);
+
+  useEffect(() => {
+    if (!active || !lyrics) read(false);
+  }, [ active, lyrics ]);
+
+  const back = () => {
+    if (showLyrics) read(false);
+    else switchScreen({ screenId: 'NowPlaying' });
+  };
+
+  useEncoderGesture(active, ({ event, value }) => {
+    if (event === 'long') back();
+    if (showLyrics) {
+      if (event === 'rotate') lyricsNode.current?.scrollBy(0, 48 * (value || 0));
+      return;
+    }
+    if (event === 'rotate') select((index) => moveSelection(Math.min(index, options.length - 1), value || 0, options.length));
+    if (event === 'short') options[selection]?.activate();
+  });
+
+  return <div className={`Viewport Kiosk-menu ${className || ''}`} style={style}>
+    <div className="Kiosk-menuBody">
+      <button type="button" className="Kiosk-back" onClick={back}>{russian ? 'Назад' : 'Back'}</button>
+      {showLyrics ? <div className="Kiosk-lyrics" ref={lyricsNode}>
+        {lyrics.type === 'plain' ? lyrics.lines.join('\n') : lyrics.type === 'synced' ?
+          lyrics.lines.map((line) => line.text).join('\n') :
+          new DOMParser().parseFromString(lyrics.lines.replace(/<br\s*\/?>/gi, '\n'), 'text/html').body.textContent}
+      </div> : options.map(({ name, activate }, index) =>
+        <button type="button" key={name} onClick={() => {
+          select(index); activate();
+        }}
+        data-encoder-selected={selection === index ? 'true' : undefined}>{name}</button>)}
+    </div>
+  </div>;
+}
diff --git a/src/kiosk/Data.tsx b/src/kiosk/Data.tsx
new file mode 100644
index 0000000..bb750ea
--- /dev/null
+++ b/src/kiosk/Data.tsx
@@ -0,0 +1,98 @@
+import React, { createContext, useContext, useEffect, useState } from 'react';
+import type { MetadataLyrics } from 'now-playing-common';
+import { useAppContext } from '../contexts/AppContextProvider';
+import { usePlayerState } from '../contexts/PlayerProvider';
+import { useMetadataService } from '../contexts/ServiceProvider';
+import { useSocket } from '../contexts/SocketProvider';
+
+export const isKiosk = window.location.origin === 'http://localhost:4004';
+
+type Quality = {
+  bitrate?: number;
+  bitrateEstimated?: boolean;
+  sampleRate?: number;
+  dsdRate?: number;
+  bitDepth?: number;
+  channels?: number;
+};
+
+export function formatQuality(quality: Quality, russian: boolean) {
+  const { bitrate, bitrateEstimated, sampleRate, dsdRate, bitDepth, channels } = quality;
+  const number = new Intl.NumberFormat(russian ? 'ru' : 'en', { maximumFractionDigits: 3, useGrouping: false });
+  const units = russian ? [ 'кбит/с', 'кГц', 'МГц', 'бит' ] : [ 'kbps', 'kHz', 'MHz', 'bit' ];
+  const channelUnit = russian ? new Intl.PluralRules('ru').select(channels || 0) : '';
+  const channelLabel = russian ? (channelUnit === 'one' ? 'канал' : channelUnit === 'few' ? 'канала' : 'каналов') :
+    channels === 1 ? 'channel' : 'channels';
+  return [
+    bitrate && bitrate > 0 ? `${bitrateEstimated ? '≈' : ''}${number.format(bitrate)} ${units[0]}` : '',
+    dsdRate && dsdRate > 0 ? `DSD ${number.format(dsdRate / 1e6)} ${units[2]}` :
+      sampleRate && sampleRate > 0 ? `${number.format(sampleRate / 1000)} ${units[1]}` : '',
+    bitDepth && bitDepth > 0 ? `${number.format(bitDepth)} ${units[3]}` : '',
+    channels && channels > 0 ? `${number.format(channels)} ${channelLabel}` : ''
+  ].filter(Boolean).join(' · ');
+}
+
+const Data = createContext<{ quality: Quality; lyrics?: MetadataLyrics }>({ quality: {} });
+export const useKioskData = () => useContext(Data);
+
+export function KioskDataProvider({ children }: { children: React.ReactNode }) {
+  const { uri, service, status, title, artist, album, duration, position } = usePlayerState();
+  const { pluginInfo } = useAppContext();
+  const { socket } = useSocket();
+  const metadata = useMetadataService();
+  const active = status !== 'stop';
+  const key = JSON.stringify([ uri, service, title, artist, album, position, active ]);
+  const [ quality, setQuality ] = useState<{ key: string; data: Quality }>();
+  const [ lyrics, setLyrics ] = useState<{ key: string; data: MetadataLyrics }>();
+  const apiPath = pluginInfo?.apiPath;
+
+  useEffect(() => {
+    if (!isKiosk || !uri || !active) return;
+    let controller: AbortController | undefined;
+    const request = () => {
+      controller?.abort();
+      const pending = new AbortController();
+      controller = pending;
+      fetch(`/kiosk/quality?uri=${encodeURIComponent(uri)}`, { signal: pending.signal })
+        .then((response) => response.ok ? response.json() : {})
+        .then((data) => {
+          if (!pending.signal.aborted) setQuality({ key, data });
+        }).catch(() => undefined);
+    };
+    const changed = (event: { uri?: string }) => {
+      if (event?.uri === uri) request();
+    };
+    request();
+    socket?.on('connect', request);
+    socket?.on('reconnect', request);
+    socket?.on('pushYandexQuality', changed);
+    socket?.on('pushQobuzCustomQuality', changed);
+    return () => {
+      controller?.abort();
+      socket?.off('connect', request);
+      socket?.off('reconnect', request);
+      socket?.off('pushYandexQuality', changed);
+      socket?.off('pushQobuzCustomQuality', changed);
+      setQuality(undefined);
+    };
+  }, [ uri, key, active, socket ]);
+
+  useEffect(() => {
+    if (!isKiosk || !apiPath || !title || !uri || !active) return;
+    let current = true;
+    metadata.fetchSongInfo({ name: title, artist, album, duration, uri, service }).then((result) => {
+      if (!current || !result?.success) return;
+      const data = result.data.song?.lyrics;
+      if (data?.lines.length) setLyrics({ key, data });
+    }).catch(() => undefined);
+    return () => {
+      current = false;
+      setLyrics(undefined);
+    };
+  }, [ metadata, apiPath, key, active, uri, title, artist, album, duration, service ]);
+
+  return <Data.Provider value={{
+    quality: quality?.key === key ? quality.data : {},
+    lyrics: lyrics?.key === key ? lyrics.data : undefined
+  }}>{children}</Data.Provider>;
+}
